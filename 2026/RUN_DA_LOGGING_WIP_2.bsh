String MMfolder = guisavepath+"/Experiment_"+ExpDate;
mkDir(MMfolder); cp(settingsFilename, MMfolder+"/Experiment_"+ExpDate+"_settings.txt"); 

// Make sure valve 2 is open
serialWrite(vport, "v2on");

// List of command numbers repeated per cycle
int patternPosition = 10; // 10 right now, could write something that auto detects where this is.
String patternList = fromfile[patternPosition].trim(); // Get multipattern list.
int patternLength = fromfile[patternPosition].trim().length();
int patternRepeats = guitrials.intValue();	// parse the number of repeats

// Setup logging of stimulator data to experiment folder
String saveFile = MMfolder+"/data_log.log"; print(saveFile);
int secToRecord = patternLength*patternRepeats*inttrialinterval; print(secToRecord);
ConfigureLogging(pythonPath, scriptPath, comPort, saveFile, secToRecord); mmc.sleep(2000);

// The first command line
int commandPosition = 15;
for (int repCounter=1; repCounter<=patternRepeats; repCounter++) {
	/*
	 * 	Wait for user defined time before running next acquisition.
	 */
	if (repCounter > 1) {
   	syswait = (INTERVAL_SEC * 1000 - acqduration - 3);
      waitForNextTrial( (int) syswait);
	}
	
	for (int acqCounter=1; acqCounter<=patternLength; acqCounter++) {
	   // Actions to run if the loop was run more than once.
		
		/*
		 * 	Wait for user defined time before running next acquisition.
		 */
		 
	   if (acqCounter == 61) {	
	   			syswait = (INTERVAL_SEC *60000 - acqduration - 3);
	      		waitForNextTrial( (int) syswait);
	      		// This sets the interval from test 60-61 to be 60 minutes
	   }
	   
	  	else if (acqCounter > 1) {
	   	syswait = (INTERVAL_SEC * 1000 - acqduration - 3);
	      waitForNextTrial( (int) syswait);
	   }
		
		// get time at start of cycle
		firsttime = System.currentTimeMillis();
	  	char patternNumChar = patternList.charAt(acqCounter - 1); 			// i-1 since first char is at position patternList[0]. 
		int  patternNum = Character.getNumericValue(patternNumChar);
		
		// Check below the pattern list in the text file for correct string to send. e.g. pattern 2 should be 2 lines below the pattern list.
		String serial_msg = fromfile[patternNum + patternPosition].trim(); 		// for microcontroller (uno)
		stimulusCommand = fromfile[commandPosition+patternNum-1].trim(); 
		print("patternNum="+patternNum); 
		print("stimCommand="+stimulusCommand); // get cycle-specific stimjim command
		
		// send command to stimjim
		mmc.setSerialPortCommand(sport, stimulusCommand, "\n"); 
		mmc.sleep(SERIAL_WAIT); 	// 1.5 ms
		waitForSerial(sport, "V"); // wait for confirmation
		
		// set stimjim to output when input trigger signal rises (E1)

		// try with string of (repCounter-1) instead of 0 to trigger the encoded stimPulseCommand
		mmc.setSerialPortCommand(sport,"R0,0","\n");
		mmc.sleep(SERIAL_WAIT); 	// 1.5 ms
		waitForSerial(sport, "V"); // wait for confirmation		// print("Interrupt attatched");

		serialWrite(vport, serial_msg); 	// Reset Arduino counter and program
	
		// Set filename and acquire stream
		filename = setFilename( acqCounter, repCounter); 
		acqduration = streamAcquisitionAndSave(guisavepath, MMfolder, filename, intduration);

	}	// End Stimulus Pattern String
	
} 	// End Full Experiment Loop

// Turn off stimjim triggering
mmc.setSerialPortCommand(sport,"R0","\n"); mmc.sleep(SERIAL_WAIT); 	// 1.5 ms
waitForSerial(sport, "V"); // wait for confirmation mmc.sleep(SERIAL_WAIT);

// Close outflow valve
serialWrite(vport, "v2off"); displayInfo("Closed Outflow Valve "+"\n*** End of Script ***");

}  // End loop for single stimulus

